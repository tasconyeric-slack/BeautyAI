# --- launch guards. production: no mock analysis / image edit / payment, no stub QC; a missing key fails loudly
# instead of silently falling back to fixtures. ALLOW_MOCK_PROVIDERS=1 re-enables mocks for a labelled public demo
# (the UI then shows a demo banner on every passport).
APP_ENV=development
ALLOW_MOCK_PROVIDERS=
# --- analysis model (DeepSeek). Leave empty to run on the fixture analysis (demo mode).
DEEPSEEK_API_KEY=
# deepseek | fake | auto (auto = deepseek when the key is set, else fake — fake only outside production)
ANALYSIS_PROVIDER=auto
# --- image edit (Recommended Look). Alibaba Model Studio / DashScope China (Beijing); use a Beijing-region API key.
DASHSCOPE_API_KEY=
# optional: overrides providers.qwen.base_url in config/models.yaml, e.g. the Beijing workspace endpoint
# https://<WorkspaceId>.cn-beijing.maas.aliyuncs.com/api/v1 (API Host in the console; a bare host gets /api/v1 appended)
DASHSCOPE_BASE_URL=
# qwen | fake | none | auto
IMAGE_EDIT_PROVIDER=auto
# --- payments (D27): fake settles every checkout at once (refused when APP_ENV=production → invite codes only); real WeChat Pay / Alipay need merchant credentials (D3)
PAYMENT_PROVIDER=fake
# comma-separated codes that unlock the full passport without payment (invite campaigns)
INVITE_UNLOCK_CODES=
# unsaved passports: JSON deleted after N days (photos still 24 h)
PASSPORT_TTL_DAYS=7
# web origin used to build share links, e.g. https://example.cn (empty = relative /s/<token>)
SHARE_BASE_URL=
# --- CV: real (MediaPipe; run `make models`) | stub (everything passes; dev/CI only)
QC_MODE=real

# --- API guardrails
INVITE_CODES=
DAILY_PASSPORT_LIMIT=30
IP_PASSPORTS_PER_HOUR=5
MAX_UPLOAD_MB=15
MEDIA_TTL_HOURS=24
PREVIEW_CAP=3
WEB_ORIGINS=http://localhost:3000
# RUNS_DIR=runs

# --- web (web/.env.local)
# NEXT_PUBLIC_API_BASE=http://localhost:8000
